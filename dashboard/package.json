{
  "name": "thermgas-ci-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "data": "node ../scripts/build-data.js && node scripts/build-map.mjs",
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "deploy": "npm run data && npm run build && node scripts/deploy-pages.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/poppins": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "typescript": "^5.6.3",
    "us-atlas": "^3.0.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
